# Summary backend: "ollama" (local, free — default) or "claude" (Anthropic API, paid)
SUMMARY_BACKEND=ollama

# Ollama settings (only used when SUMMARY_BACKEND=ollama)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# Claude settings (only used when SUMMARY_BACKEND=claude)
ANTHROPIC_API_KEY=
