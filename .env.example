# LLM backend for summaries and methodology extraction:
# "ollama" (local, free — default) or "claude" (Anthropic API, paid).
# SUMMARY_BACKEND from older setups still works.
LLM_BACKEND=ollama

# Ollama settings (only used when LLM_BACKEND=ollama)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# Claude settings (only used when LLM_BACKEND=claude)
ANTHROPIC_API_KEY=

# Optional: free Semantic Scholar API key for higher rate limits
# (https://www.semanticscholar.org/product/api). Works without one.
SEMANTIC_SCHOLAR_API_KEY=
